<section id="shop" class="tab-content">
 <div class="panel"><div class="panel-head"><div><h2>Market stall</h2><div class="sub">Buy stock from the server, then sell it for profit.</div></div><span class="tag">SERVER SHOP</span></div><div id="shopGrid" class="grid"></div></div>
