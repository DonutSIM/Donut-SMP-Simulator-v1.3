<script>
const ITEMS=[
{id:'cobble',name:'Cobblestone',emoji:'🪨',buy:12,sell:5,desc:'The classic starter block.',tag:'COMMON'},
{id:'wood',name:'Oak Log',emoji:'🪵',buy:25,sell:11,desc:'Useful, stackable and easy to flip.',tag:'COMMON'},
{id:'iron',name:'Iron Ingot',emoji:'🔩',buy:95,sell:55,desc:'A reliable mid-game commodity.',tag:'UNCOMMON'},
{id:'gold',name:'Gold Ingot',emoji:'🟨',buy:180,sell:110,desc:'Shiny, valuable and always moving.',tag:'UNCOMMON'},
{id:'diamond',name:'Diamond',emoji:'💎',buy:650,sell:420,desc:'A premium item for serious traders.',tag:'RARE'},
{id:'emerald',name:'Emerald',emoji:'🟢',buy:490,sell:315,desc:'Villager-approved green money.',tag:'RARE'},
{id:'netherite',name:'Netherite Scrap',emoji:'⬛',buy:1850,sell:1250,desc:'High risk, high value.',tag:'EPIC'},
{id:'totem',name:'Totem of Undying',emoji:'🗿',buy:3200,sell:2200,desc:'A luxury collectible.',tag:'LEGENDARY'}
 ,
{id:'netherite_sword',name:'Netherite Sword',emoji:'⚔️',buy:18000,sell:12500,desc:'Rare netherite weapon from the shard shop.',tag:'SHARD SHOP'},
{id:'netherite_pickaxe',name:'Netherite Pickaxe',emoji:'⛏️',buy:16000,sell:11000,desc:'Premium netherite mining tool.',tag:'SHARD SHOP'},
{id:'netherite_chestplate',name:'Netherite Chestplate',emoji:'🛡️',buy:24000,sell:17000,desc:'Heavy netherite armour.',tag:'SHARD SHOP'},
{id:'skeleton_bone',name:'Bones',emoji:'🦴',buy:90,sell:55,desc:'Bones generated by skeleton spawners.',tag:'MOB DROP'}
];
const $=id=>document.getElementById(id); const fmt=n=>'$'+Math.floor(n).toLocaleString('en-US');
let state;
function fresh(){return {money:250,inv:{},listings:[],orders:[],nextId:1,claimedDay:'',lastWork:0,earned:0,transactions:0}}
try{state=JSON.parse(localStorage.getItem('donutEconomySave'))||fresh()}catch(e){state=fresh()}
function save(){localStorage.setItem('donutEconomySave',JSON.stringify(state));render()}
function item(id){return ITEMS.find(x=>x.id===id)}
function countItems(){return Object.values(state.inv).reduce((a,b)=>a+b,0)}
function invValue(){return Object.entries(state.inv).reduce((a,[id,q])=>a+q*(item(id)?.sell||0),0)}
function level(){return Math.floor(Math.sqrt(Math.max(0,state.earned)/1000))+1}
function notify(t){let el=$('toast');el.textContent=t;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
function addItem(id,q){state.inv[id]=(state.inv[id]||0)+q;if(state.inv[id]<=0)delete state.inv[id]}
function spend(n){if(state.money<n){notify('Not enough money!');return false}state.money-=n;return true}
function earn(n){state.money+=n;state.earned+=n;state.transactions++}
function buy(id,q=1){let it=item(id),cost=it.buy*q;if(!spend(cost))return;addItem(id,q);save();notify(`Bought ${q}× ${it.name} for ${fmt(cost)}`)}
function sell(id,q=1){let it=item(id);q=Math.min(q,state.inv[id]||0);if(q<1)return;let total=it.sell*q;addItem(id,-q);earn(total);save();notify(`Sold ${q}× ${it.name} for ${fmt(total)}`)}
function switchTab(id,btn){document.querySelectorAll('.tab-content').forEach(x=>x.hidden=x.id!==id);document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));render()}
function dailyClaim(){let day=new Date().toISOString().slice(0,10);if(state.claimedDay===day){notify('Daily bonus already claimed — come back tomorrow!');return}state.claimedDay=day;earn(500+Math.floor(Math.random()*251));save();notify('Daily bonus claimed! Cash added to wallet.')}
function work(){let now=Date.now();if(now-state.lastWork<3500){notify('Catch your breath — try again in a moment.');return}state.lastWork=now;let payout=35+Math.floor(Math.random()*66);earn(payout);save();notify(`You completed a quick grind and earned ${fmt(payout)}!`)}
function createListing(){let id=$('listItem').value,q=Math.floor(+$('listQty').value),price=Math.floor(+$('listPrice').value);if(!id||q<1||price<1){notify('Choose an item, quantity and price.');return}if((state.inv[id]||0)<q){notify('You do not have enough items.');return}let fee=Math.max(1,Math.ceil(price*.05));if(!spend(fee))return;addItem(id,-q);state.listings.unshift({id:state.nextId++,item:id,qty:q,price,owner:'You',mine:true});save();notify(`Listed ${q}× ${item(id).name}. Listing fee: ${fmt(fee)}.`)}
function buyListing(id){let l=state.listings.find(x=>x.id===id);if(!l)return;if(!spend(l.price))return;addItem(l.item,l.qty);state.listings=state.listings.filter(x=>x.id!==id);state.earned+=0;state.transactions++;save();notify(`Purchased ${l.qty}× ${item(l.item).name}!`)}
function cancelListing(id){let l=state.listings.find(x=>x.id===id);if(!l||!l.mine)return;addItem(l.item,l.qty);state.listings=state.listings.filter(x=>x.id!==id);save();notify('Listing cancelled; items returned.')}
function generateListings(){let names=['BlockBargain','xXMinerXx','DonutDealer','CobbleKing','EmeraldEnjoyer','CraftyFox'];for(let i=0;i<5;i++){let it=ITEMS[Math.floor(Math.random()*ITEMS.length)],q=1+Math.floor(Math.random()*5),price=Math.max(1,Math.floor(it.buy*q*(.72+Math.random()*.85)));state.listings.push({id:state.nextId++,item:it.id,qty:q,price,owner:names[Math.floor(Math.random()*names.length)],mine:false})}}
function refreshOrders(){state.orders=[];let names=['BlockBargain','DonutDealer','CraftyFox','Steve','EmeraldEnjoyer','xXMinerXx'];for(let i=0;i<5;i++){let it=ITEMS[Math.floor(Math.random()*ITEMS.length)],q=1+Math.floor(Math.random()*4),unit=Math.floor(it.sell*(1.4+Math.random()*1.8));state.orders.push({id:state.nextId++,item:it.id,qty:q,unit,owner:names[Math.floor(Math.random()*names.length)]})}save();notify('Fresh player orders posted!')}
function fulfilOrder(id){let o=state.orders.find(x=>x.id===id);if(!o)return;if((state.inv[o.item]||0)<o.qty){notify(`Need ${o.qty}× ${item(o.item).name} to fulfil this order.`);return}addItem(o.item,-o.qty);let total=o.qty*o.unit;earn(total);state.orders=state.orders.filter(x=>x.id!==id);save();notify(`Order fulfilled! You earned ${fmt(total)}.`)}
function renderShop(){$('shopGrid').innerHTML=ITEMS.map(it=>`<div class="item"><div class="item-top"><span class="emoji">${it.emoji}</span><span class="tag">${it.tag}</span></div><h3>${it.name}</h3><div class="desc">${it.desc}</div><div class="price">Buy ${fmt(it.buy)} <span style="color:var(--muted);font-size:11px">/ ea</span></div><button class="primary" onclick="buy('${it.id}')">Buy 1</button><button style="margin-top:6px" onclick="buy('${it.id}',5)">Buy 5</button></div>`).join('');$('sellGrid').innerHTML=ITEMS.filter(it=>(state.inv[it.id]||0)>0).map(it=>`<div class="item"><div class="item-top"><span class="emoji">${it.emoji}</span><span class="tag">OWNED: ${state.inv[it.id]}</span></div><h3>${it.name}</h3><div class="desc">Server buy-back price</div><div class="price">${fmt(it.sell)} <span style="color:var(--muted);font-size:11px">/ ea</span></div><button class="good" onclick="sell('${it.id}',1)">Sell 1</button><button style="margin-top:6px" onclick="sell('${it.id}',${state.inv[it.id]})">Sell all (${state.inv[it.id]})</button></div>`).join('')||'<div class="empty" style="grid-column:1/-1">Your pockets are empty. Buy some stock above to get started!</div>'}
function renderListings(){$('auctionList').innerHTML=state.listings.length?state.listings.map(l=>{let it=item(l.item);return `<div class="listing"><div class="listing-left"><span class="emoji">${it.emoji}</span><div><h3>${l.qty}× ${it.name}</h3><small>Listed by ${l.owner}${l.mine?' · Your listing':''}</small></div></div><div class="listing-actions"><strong>${fmt(l.price)}</strong>${l.mine?`<button onclick="cancelListing(${l.id})">Cancel</button>`:`<button class="primary" onclick="buyListing(${l.id})">Buy</button>`}</div></div>`}).join(''):'<div class="empty">No listings right now. Add one of your items or refresh orders for new activity.</div>'}
function renderOrders(){$('ordersList').innerHTML=state.orders.length?state.orders.map(o=>{let it=item(o.item),total=o.unit*o.qty,has=(state.inv[o.item]||0)>=o.qty;return `<div class="listing"><div class="listing-left"><span class="emoji">${it.emoji}</span><div><h3>Wanted: ${o.qty}× ${it.name}</h3><small>${o.owner} · ${fmt(o.unit)} per item · You own ${state.inv[o.item]||0}</small></div></div><div class="listing-actions"><strong>${fmt(total)}</strong><button class="${has?'good':''}" ${has?'':'disabled'} onclick="fulfilOrder(${o.id})">Fulfil</button></div></div>`}).join(''):'<div class="empty">No active orders. Click “New orders” to generate more.</div>'}
function renderInventory(){let entries=Object.entries(state.inv).filter(([id,q])=>q>0);$('inventoryList').innerHTML=entries.length?entries.map(([id,q])=>{let it=item(id);return `<div class="inventory-row"><div class="listing-left"><span class="emoji">${it.emoji}</span><div><h3>${it.name}</h3><small>${q} owned · server value ${fmt(it.sell*q)}</small></div></div><div class="listing-actions"><button class="good" onclick="sell('${id}',1)">Sell 1</button><button onclick="switchTab('auction',document.querySelector('[data-tab=auction]'));$('listItem').value='${id}'">Auction</button></div></div>`}).join(''):'<div class="empty">Nothing in your inventory yet. Head to the shop and start trading.</div>'}
function render(){ $('moneyTop').textContent=fmt(state.money);$('moneyStat').textContent=fmt(state.money);$('itemCount').textContent=countItems().toLocaleString();$('netWorth').textContent=fmt(state.money+invValue()+state.listings.filter(l=>l.mine).reduce((s,l)=>s+l.price,0));let lv=level(),floor=(lv-1)*(lv-1)*1000,next=lv*lv*1000,prog=Math.min(100,Math.max(0,(state.earned-floor)/(next-floor)*100));$('levelBar').style.width=prog+'%';$('levelText').textContent=`Level ${lv} · ${fmt(Math.max(0,state.earned-floor))} / ${fmt(next-floor)} earned toward next level`;let sel=$('listItem'),old=sel.value;sel.innerHTML=ITEMS.map(it=>`<option value="${it.id}" ${(state.inv[it.id]||0)<1?'disabled':''}>${it.emoji} ${it.name} (${state.inv[it.id]||0} owned)</option>`).join('');if(old&&state.inv[old])sel.value=old;renderShop();renderListings();renderOrders();renderInventory()}
if(!state.listings.length)generateListings();if(!state.orders.length)refreshOrders();render();
</script>

<script id="live-market-engine">
(function(){
 const names=['BigDonut','EmeraldEnjoyer','xXMinerXx','BlockBargain','NotSoggy','Taco1234','LilNugget','CraftyFox','DiamondDude','VoidWalker','CobbleKing','MuffinPvP'];
 const styles=['flipper','hoarder','bargain','panic','steady','whale'];
 let tick=1,trades=0,events=[],lastTick=Date.now(),marketMood='Balanced';
 const base={}; ITEMS.forEach(it=>base[it.id]=it.buy);
 function say(name,icon,msg){events.unshift({name,icon,msg,time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'})});events=events.slice(0,14);renderFeed()}
 function fmtDelta(n){return (n>=0?'+':'')+Math.round(n).toLocaleString('en-US')}
 function price(it){return Math.max(1,Math.round(it.buy))}
 function liveTick(){
   tick++;
   ITEMS.forEach(it=>{if(base[it.id]===undefined)base[it.id]=it.buy});
   let movement=[];
   ITEMS.forEach(it=>{
     let old=it.buy;
     // Demand, randomness and NPC activity influence each item independently.
     let demand=(Math.random()-.48)*.11;
     let npcPush=(Math.random()-.5)*.07;
     if(it.id==='diamond'||it.id==='netherite'||it.id==='totem') npcPush+=Math.random()*.025;
     let next=Math.round(old*(1+demand+npcPush));
     it.buy=Math.max(Math.round(base[it.id]*.45),Math.min(Math.round(base[it.id]*2.8),next));
     it.sell=Math.max(1,Math.round(it.buy*(.48+Math.random()*.05)));
     let pct=(it.buy-old)/Math.max(1,old)*100;
     if(Math.abs(pct)>2.2)movement.push({it,pct});
   });
   // A few independent simulated traders transact each market tick.
   let actions=2+Math.floor(Math.random()*4);
   for(let i=0;i<actions;i++){
     let name=names[Math.floor(Math.random()*names.length)],style=styles[Math.floor(Math.random()*styles.length)];
     let it=ITEMS[Math.floor(Math.random()*ITEMS.length)];
     if(style==='hoarder'){
       say(name,'📦',`is hoarding ${it.name} — demand is rising.`);
       it.buy=Math.min(Math.round(base[it.id]*2.8),Math.round(it.buy*1.012));
     } else if(style==='bargain'){
       say(name,'🪙',`placed a bargain order for ${it.name} at ${fmt(it.buy*.85)}.`);
     } else if(style==='panic'){
       say(name,'⚠️',`dumped ${it.name} stock; market supply increased.`);
       it.buy=Math.max(Math.round(base[it.id]*.45),Math.round(it.buy*.985));
     } else if(style==='whale'){
       say(name,'🐋',`made a large ${it.name} market purchase.`);
       it.buy=Math.min(Math.round(base[it.id]*2.8),Math.round(it.buy*1.025));
     } else if(style==='flipper'){
       say(name,'🔁',`is flipping ${it.name}; watching the spread closely.`);
     } else {
       say(name,'🧑‍🌾',`completed a routine trade in ${it.name}.`);
     }
     trades++;
   }
   let avg=ITEMS.reduce((s,it)=>s+(it.buy-base[it.id])/base[it.id],0)/ITEMS.length;
   marketMood=avg>.12?'Bullish':avg<-.12?'Bearish':'Balanced';
   $('marketClock').textContent='TICK #'+tick+' · '+new Date().toLocaleTimeString();
   $('aiCount').textContent=10+Math.floor(Math.random()*7);
   $('tradeCount').textContent=trades.toLocaleString();
   $('marketMood').textContent=marketMood;
   renderTicker(); render();
   if(movement.length){let m=movement[0];say('Market Watch','📊',`${m.it.name} moved ${m.pct>0?'up':'down'} ${Math.abs(m.pct).toFixed(1)}% this tick.`)}
 }
 function renderTicker(){
   $('priceTicker').innerHTML=ITEMS.map(it=>{let pct=(it.buy-base[it.id])/base[it.id]*100;return `<span>${it.emoji} ${it.name} <b style="color:#ffff55">${fmt(it.buy)}</b> <b class="market-change ${pct>=0?'up':'down'}">${pct>=0?'▲':'▼'}${Math.abs(pct).toFixed(1)}%</b></span>`}).join('');
 }
 function renderFeed(){
   if(!$('aiFeed'))return;
   $('aiFeed').innerHTML=events.map(e=>`<div class="ai-event"><div class="ai-avatar">${e.icon}</div><div><strong>${e.name}</strong> <span style="color:#888">${e.time}</span><br>${e.msg}</div></div>`).join('');
 }
 // Expose market price changes to the original interface and update shop labels.
 window.donutLiveMarket={getTick:()=>tick,getTrades:()=>trades,getMood:()=>marketMood};
 say('Server','🟢','Live simulated economy connected. Smart NPC traders are entering the market.');
 say('BigDonut','🍩','Looking for underpriced diamonds — post your offers!');
 say('EmeraldEnjoyer','🟢','Emerald demand is steady. Keeping an eye on the market.');
 renderTicker();
 setInterval(()=>{lastTick=Date.now();liveTick();$('tickTimer').textContent='4s';},4000);
 let countdown=3;setInterval(()=>{$('tickTimer').textContent=(countdown--<=0?4:countdown+1)+'s';if(countdown<0)countdown=3},1000);
 // Make AI market listings refreshable, but do not let NPCs remove the user's own listings.
 const oldRefresh=window.refreshOrders;
 window.refreshOrders=function(){oldRefresh();say('Order Board','📜','New buy orders generated by the simulated player economy.')}
})();
</script>


