<script id="scoreboard-afk-offline-upgrade">
(function(){
  // Persistent stats and AFK shard accrual; all existing game systems are retained.
  state.shards=Number.isFinite(state.shards)?state.shards:0;
  state.stats=state.stats||{};
  const now=Date.now();
  state.stats.createdAt=state.stats.createdAt||now;
  state.stats.playMs=Number(state.stats.playMs)||0;
  state.stats.lastSeen=Number(state.stats.lastSeen)||now;
  state.stats.afkRemainder=Number(state.stats.afkRemainder)||0;
  state.stats.shardsEarned=Number(state.stats.shardsEarned)||state.shards;
  state.stats.totalEarned=Number(state.stats.totalEarned)||Number(state.earned)||0;
  state.stats.sessions=Number(state.stats.sessions)||0;
  state.stats.sessions++;
  // Earn 1 shard per 5 minutes away/open, capped at 12 hours per return.
  function accrue(elapsed){
    elapsed=Math.max(0,Math.min(elapsed,12*60*60*1000));
    const total=elapsed+(state.stats.afkRemainder||0),earned=Math.floor(total/300000);
    state.stats.afkRemainder=total%300000;
    if(earned>0){state.shards+=earned;state.stats.shardsEarned+=earned;state.stats.afkShards=(state.stats.afkShards||0)+earned;}
    return earned;
  }
  const offlineEarned=accrue(now-state.stats.lastSeen);
  state.stats.lastSeen=now;
  const tabs=document.querySelector('.tabs');
  if(tabs&&!tabs.querySelector('[data-tab="scoreboard"]'))tabs.insertAdjacentHTML('beforeend','<button data-tab="scoreboard" onclick="switchTab(\'scoreboard\',this)">🏆 Scoreboard</button>');
  const footer=document.querySelector('.footer');
  if(footer&&!$('scoreboard'))footer.insertAdjacentHTML('beforebegin',`<section id="scoreboard" class="tab-content" hidden><div class="panel"><div class="panel-head"><div><h2>🏆 Scoreboard</h2><div class="sub">Your personal Donut Economy stats.</div></div><button onclick="renderScoreboard()">↻ Refresh</button></div><div id="scoreboardGrid" class="grid"></div><div class="notice" style="display:block;margin-top:12px">💠 AFK shards: earn 1 shard every 5 minutes while playing or away. Offline progress is calculated when you return (up to 12 hours per visit).</div></div></section>`);
  function duration(ms){let m=Math.floor(ms/60000),h=Math.floor(m/60);m%=60;let d=Math.floor(h/24);h%=24;return d?`${d}d ${h}h ${m}m`:h?`${h}h ${m}m`:`${m}m`}
  window.renderScoreboard=function(){const el=$('scoreboardGrid');if(!el)return;const inventoryCount=Object.values(state.inv||{}).reduce((a,b)=>a+Math.max(0,Number(b)||0),0);const invValue=Object.entries(state.inv||{}).reduce((sum,[id,q])=>{const it=item(id);return sum+(it?it.sell*Math.max(0,Number(q)||0):0)},0);const listingValue=(state.listings||[]).filter(x=>x.mine).reduce((a,x)=>a+(Number(x.price)||0),0);const stats=[['💰 Wallet',fmt(state.money)],['💎 Shards',(state.shards||0).toLocaleString()],['🏦 Net worth',fmt((state.money||0)+invValue+listingValue)],['🎒 Items owned',inventoryCount.toLocaleString()],['📈 Total earned',fmt(state.earned||0)],['🔁 Transactions',(state.transactions||0).toLocaleString()],['🛒 Auction listings',(state.listings||[]).filter(x=>x.mine).length],['📜 Active orders',(state.orders||[]).length],['🧟 Skeleton spawners',(state.spawners&&state.spawners.skeleton)||0],['💠 AFK shards earned',(state.stats.afkShards||0).toLocaleString()],['⏱️ Playtime',duration((state.stats.playMs||0)+(Date.now()-(state.stats.sessionStart||Date.now())))],['📅 Account age',duration(Date.now()-(state.stats.createdAt||Date.now()))],['🎁 Shards earned total',(state.stats.shardsEarned||0).toLocaleString()],['🖥️ Sessions',(state.stats.sessions||1).toLocaleString()]];el.innerHTML=stats.map(([label,value])=>`<div class="item"><div class="desc">${label}</div><h3 style="font-size:23px;margin-top:8px">${value}</h3></div>`).join('')};
  const oldRender=window.render;
  window.render=function(){oldRender();window.renderScoreboard()};
  state.stats.sessionStart=Date.now();
  let lastTick=Date.now();
  setInterval(function(){const t=Date.now();const delta=t-lastTick;lastTick=t;state.stats.playMs+=delta;const got=accrue(delta);state.stats.lastSeen=t;if(got)notify('AFK bonus: +'+got+' shard'+(got===1?'':'s')+'!');try{localStorage.setItem('donutEconomySave',JSON.stringify(state));if(typeof extraState!=='undefined')localStorage.setItem('donutExtrasSave',JSON.stringify(extraState))}catch(e){}window.renderScoreboard()},15000);
  document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden'){state.stats.lastSeen=Date.now();try{localStorage.setItem('donutEconomySave',JSON.stringify(state))}catch(e){}}});
  window.addEventListener('beforeunload',function(){state.stats.lastSeen=Date.now();try{localStorage.setItem('donutEconomySave',JSON.stringify(state))}catch(e){}});
  if(offlineEarned>0)setTimeout(()=>notify('Welcome back! You earned '+offlineEarned+' AFK shard'+(offlineEarned===1?'':'s')+' while away.'),700);
  try{const link=document.createElement('link');link.rel='manifest';link.href='./manifest.webmanifest';document.head.appendChild(link);if('serviceWorker' in navigator && (location.protocol==='https:'||location.hostname==='localhost'))navigator.serviceWorker.register('./sw.js').catch(()=>{});}catch(e){}
  window.renderScoreboard();try{localStorage.setItem('donutEconomySave',JSON.stringify(state))}catch(e){}
})();
</script>

</body>
