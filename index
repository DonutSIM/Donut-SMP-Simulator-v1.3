<body>
<header><div class="brand"><div class="donut"></div>DONUT <span>ECONOMY</span></div><div style="display:flex;align-items:center;gap:8px"><button onclick="openSettings()">⚙️ Settings</button><div class="wallet">🍩 <span id="moneyTop">$250</span></div></div></header>
<main>

<div class="serverbar">
  <span><span class="live-dot"></span><b id="liveStatus">LIVE MARKET: CONNECTED</b></span>
  <span>SERVER: DONUT-SIM-01</span><span id="marketClock">TICK #1</span><span>MODE: SMART NPC TRADERS</span>
</div>
<section class="hudgrid">
  <div class="hudbox">
    <h3>📈 LIVE MARKET PRICES</h3>
    <div class="ticker" id="priceTicker"></div>
    <div class="sub" style="color:#aaa;margin-top:10px">Prices shift every few seconds as simulated traders buy, sell, hoard and react to demand.</div>
  </div>
  <div class="hudbox">
    <h3>🤖 SMART AI TRADERS</h3>
    <div class="hudstats">
      <div class="hudstat">Active traders<strong id="aiCount">12</strong></div>
      <div class="hudstat">Trades today<strong id="tradeCount">0</strong></div>
      <div class="hudstat">Market mood<strong id="marketMood">Balanced</strong></div>
      <div class="hudstat">Next tick<strong id="tickTimer">4s</strong></div>
    </div>
  </div>
</section>

<section class="hero">
 <div class="hero-card"><div class="eyebrow">Your grind starts here</div><h1>Build your empire.<br><span style="color:var(--pink)">Get ridiculously rich.</span></h1><p>Buy low, sell high, complete player orders and flip the auction house. Every donut counts. Can you reach billionaire status?</p><div class="controls"><button class="primary" onclick="dailyClaim()">🎁 Claim daily bonus</button><button onclick="work()">⛏️ Quick grind</button></div><div class="progress"><div id="levelBar"></div></div><div class="sub" id="levelText">Level 1 · $0 / $1,000 toward next level</div></div>
 <div class="stats"><div class="stat"><small>💰 Wallet</small><strong id="moneyStat">$250</strong><div class="sub">Spendable cash</div></div><div class="stat"><small>📦 Items owned</small><strong id="itemCount">0</strong><div class="sub">In your inventory</div></div><div class="stat"><small>🏆 Net worth</small><strong id="netWorth">$250</strong><div class="sub">Wallet + inventory</div></div></div>
